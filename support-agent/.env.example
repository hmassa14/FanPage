# Copy to .env. All settings are prefixed SA_. Nested stage settings use SA_<STAGE>__<FIELD>.

# --- provider -------------------------------------------------------------
# "fake" runs fully offline (CI, local dev). "anthropic" calls Claude.
SA_LLM_PROVIDER=fake
# Required when SA_LLM_PROVIDER=anthropic (or run `ant auth login` and leave unset).
ANTHROPIC_API_KEY=
# Re-run policy refusals server-side on Anthropic's recommended fallback model.
SA_ANTHROPIC_FALLBACKS=true
# Per-stage model/effort. Opus 5 everywhere by default; change one stage at a time and re-run evals.
SA_TRIAGE__MODEL=claude-opus-5
SA_TRIAGE__EFFORT=low
SA_RESEARCH__MODEL=claude-opus-5
SA_RESEARCH__EFFORT=high
SA_DRAFT__MODEL=claude-opus-5
SA_DRAFT__EFFORT=high
SA_JUDGE__MODEL=claude-opus-5
SA_JUDGE__EFFORT=medium

# --- retrieval: bm25 (default) | hybrid (Weaviate BM25 + vector fusion) -----------
SA_RETRIEVER=bm25
SA_HYBRID_ALPHA=0.5
# Embeddings for hybrid: voyage (needs VOYAGE_API_KEY) | hash (key-free lexical fallback)
SA_EMBEDDER=hash
SA_VOYAGE_MODEL=voyage-3.5
VOYAGE_API_KEY=
# embedded = Weaviate runs in-process (dev/tests); remote = a Weaviate server (compose / cloud)
SA_WEAVIATE_MODE=embedded
SA_WEAVIATE_URL=http://localhost:8080
SA_WEAVIATE_GRPC_PORT=50051
SA_WEAVIATE_API_KEY=

# --- persona ----------------------------------------------------------------
SA_COMPANY_NAME=Northwind Outfitters
SA_SUPPORT_ADDRESS=support@northwind-outfitters.example

# --- delivery: console | file | smtp -----------------------------------------
SA_SENDER=console
SA_SMTP_HOST=
SA_SMTP_PORT=587
SA_SMTP_USERNAME=
SA_SMTP_PASSWORD=

# --- ingestion: file inbox is always on; IMAP is optional ---------------------
SA_IMAP_HOST=
SA_IMAP_USERNAME=
SA_IMAP_PASSWORD=
SA_WORKER_POLL_SECONDS=5

# --- api ------------------------------------------------------------------------
SA_ADMIN_TOKEN=change-me
SA_LOG_JSON=true
SA_LOG_LEVEL=INFO

# --- tracing: none | console | otlp -----------------------------------------------
# With docker compose, Jaeger is at http://localhost:16686 and receives OTLP on :4318.
SA_OTEL_EXPORTER=none
SA_OTEL_ENDPOINT=http://localhost:4318
SA_OTEL_SERVICE_NAME=support-agent
